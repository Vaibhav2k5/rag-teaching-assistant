# Copy to .env and fill in. The workspace-level .env one folder up is also read,
# so if your Hugging Face token is already there you don't need to repeat it.

# Set ONE LLM key. With LLM_PROVIDER=auto the first one found is used, in this order.
# Free option: a Gemini key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here   # also used to download Whisper/embedding models

# Optional overrides (defaults shown)
# LLM_PROVIDER=auto             # auto / gemini / openai / anthropic / huggingface
# LLM_MODEL=                    # empty = provider default (gemini-2.5-flash, gpt-4.1-mini,
#                               #   claude-haiku-5-5, Qwen/Qwen2.5-72B-Instruct)
# LLM_TEMPERATURE=0.2
# WHISPER_MODEL=base            # tiny / base / small / medium
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# CHUNK_CHARS=800
# OVERLAP_CHARS=150
# TOP_K=5
